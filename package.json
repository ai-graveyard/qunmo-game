{
  "name": "qunmo-paper-town",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:story": "node scripts/check-story.mjs",
    "check": "npm run format:check && npm run check:story && npm test && npm run build",
    "release:pack": "npm run build && node scripts/package-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  },
  "license": "MIT",
  "description": "群魔 · 小城纸影：原创剪纸风文学叙事游戏",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-graveyard/qunmo-game.git"
  }
}
