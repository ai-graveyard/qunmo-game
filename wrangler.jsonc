{
  "name": "v2ai-games",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "vars": { "BASE_PATH": "/qunmo", "HTTPS_HOST": "game.v2ai.org" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "game.v2ai.org/qunmo", "zone_name": "v2ai.org" },
    { "pattern": "game.v2ai.org/qunmo/*", "zone_name": "v2ai.org" },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": { "enabled": false },
}
